#!/usr/bin/env bash
# Deploy corrallm: build, hand the service over to the new binary, then publish
# the UI.
#
# ORDER IS THE WHOLE POINT. ui/dist is the LIVE web root — the running daemon
# serves that directory directly via --web-root, so building the UI is a deploy
# the instant it finishes, with no further step. If the UI ships first, a query
# that gained a field hits the old schema, the server answers
# `Cannot query field "X"`, and the dashboard renders its error state instead of
# loading. A new server with an old UI is harmless; the reverse is an outage.
#
# So: binary, handoff (or restart), verify, THEN the UI.
#
# HANDOFF, NOT RESTART, when the unit allows it. `corrallm service upgrade`
# starts the new binary beside the running one with the listening socket; the
# new one takes every connection once it is ready and the old one finishes its
# in-flight requests and exits. No connection is refused and no request is
# cut. Local (non-agent) models are reloaded by the new process — the old one's
# children cannot be adopted — and requests for them wait for that load. If the
# handoff fails (the new binary does not start, or the unit predates it), the
# old process is still serving and this falls back to a restart.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"

# Deploy what we DECLARE, not what happens to be next door.
#
# go.work lists ../gwag and ../agentkit, so an ordinary build here compiles
# against those working copies — gwag's is currently several commits past the
# released version go.mod pins. That is the right default for developing them
# together and the wrong one for shipping: the binary under systemd would
# contain code that is in no release, matching no tag, reproducible nowhere.
#
# GOWORK=off ignores go.work and resolves from go.mod alone, checksum-verified
# against go.sum. Exported, so `make install` and the tests below inherit it.
#
# CONSEQUENCE, on purpose: if corrallm needs an unreleased change in gwag or
# agentkit, this deploy FAILS. Release and pin it, or set CORRALLM_DEPLOY_WORKSPACE=1
# for a deliberately unreproducible build you have chosen with your eyes open.
if [ "${CORRALLM_DEPLOY_WORKSPACE:-0}" = "1" ]; then
    say_mode="WORKSPACE (unpinned — ../gwag and ../agentkit as they are on disk)"
else
    export GOWORK=off
    say_mode="pinned (go.mod only; go.work ignored)"
fi

SERVICE="${CORRALLM_SERVICE:-corrallm}"
BASE="${CORRALLM_BASE:-http://127.0.0.1:8111}"
WITH_AGENTS=false
SKIP_UI=false
YES=false
FORCE_RESTART=false

for arg in "$@"; do
    case "$arg" in
        --agents) WITH_AGENTS=true ;;
        --no-ui)  SKIP_UI=true ;;
        -y|--yes) YES=true ;;
        --restart) FORCE_RESTART=true ;;
        -h|--help)
            cat <<EOF
Usage: $0 [--agents] [--no-ui] [-y]

  --agents   Also cross-compile agent binaries into bin/agents/.
             Attached machines self-update to whatever is there, so this
             changes every agent in the fleet, not just this box.
  --no-ui    Server only; leave ui/dist as it is.
  -y         Do not prompt before switching over.
  --restart  Restart instead of handing over (evicts every model, drops
             in-flight requests).

A handoff keeps every connection and in-flight request; local models are
reloaded by the new process. If it fails, this falls back to a restart, which
EVICTS every resident model and drops in-flight requests — asked about unless
-y. Env: CORRALLM_SERVICE, CORRALLM_BASE.
EOF
            exit 0 ;;
        *) echo "Unknown argument: $arg" >&2; exit 2 ;;
    esac
done

say() { printf '\n==> %s\n' "$1"; }

say "go build + tests — $say_mode"
go build ./...
go test ./... >/dev/null

if $WITH_AGENTS; then
    say "cross-compiling agents (attached machines will self-update to these)"
    make agents >/dev/null
fi

# What a restart costs, BEFORE asking. "Nothing is loaded" and "four models and
# a live stream" deserve different answers, and only the operator can weigh it.
if ! $YES; then
    inflight="?"
    if tok=$(cat "${CORRALLM_TOKEN_FILE:-$HOME/.corrallm/admin.token}" 2>/dev/null); then
        inflight=$(curl -fsS -m 5 -H "Authorization: Bearer $tok" "$BASE/api/v1/active" 2>/dev/null \
            | python3 -c 'import json,sys; print(len(json.load(sys.stdin).get("requests",[])))' 2>/dev/null || echo "?")
    fi
    printf '\nSwitching %s over. A handoff keeps in-flight requests and reloads local models;\n' "$SERVICE"
    printf 'if it fails, the fallback restart evicts every resident model and drops them.\n'
    printf 'In flight right now: %s\n' "$inflight"
    read -r -p "Continue? [y/N] " reply
    [[ "$reply" =~ ^[Yy]$ ]] || { echo "aborted"; exit 1; }
fi

# `install`, not `build`: the systemd unit runs $GOBIN/corrallm, and building to
# ./bin/corrallm would deploy nothing while looking like it had.
say "installing the binary to \$GOBIN (what the unit runs)"
make install >/dev/null

# AND ./bin/corrallm, which the unit does not run and everybody types.
#
# `make install` refreshes only the daemon, so the CLI beside it kept whatever
# build it had. That is not cosmetic: every `config` subcommand decodes the
# stored config into ITS OWN structs, so a CLI older than the daemon silently
# drops fields it has never heard of and answers confidently with a config that
# is missing settings the daemon is actively serving from. On 2026-09-06 that
# produced three consecutive exports with no sign of a per-model setting the
# daemon had stored, was using, and kept across a restart.
#
# `make build` rather than `go build` so it is STAMPED with srcDir and warns on
# its own once the tree moves past it.
say "rebuilding ./bin/corrallm (the CLI, so it cannot lag the daemon)"
make build >/dev/null

# Handoff needs the unit `corrallm service install` writes now (Type=notify,
# NotifyAccess=all): under an older Type=simple unit systemd would read the old
# process's exit as the service stopping and kill the new one.
unit_type=$(systemctl --user show "$SERVICE" -p Type --value 2>/dev/null || true)
old_pid=$(systemctl --user show "$SERVICE" -p MainPID --value 2>/dev/null || echo 0)
restart=false
if $FORCE_RESTART; then
    restart=true
elif [ "$unit_type" != "notify" ]; then
    echo "!! $SERVICE is Type=${unit_type:-?}, not notify: handoff unavailable (reinstall the unit: corrallm service install ...)" >&2
    restart=true
elif [ "${old_pid:-0}" = "0" ]; then
    echo "   $SERVICE is not running; starting it" >&2
    restart=true
else
    say "handing $SERVICE over to the new binary (pid $old_pid drains its requests, then exits)"
    gobin=$(go env GOBIN); [ -n "$gobin" ] || gobin="$(go env GOPATH)/bin"
    rc=0
    "$gobin/corrallm" service upgrade --name "$SERVICE" || rc=$?
    if [ "$rc" = 3 ]; then
        # The NEW binary did not start. A restart would replace a working
        # daemon with that binary, so stop here: the old one is still serving.
        echo "!! the new binary failed to start; $SERVICE is still serving the old one. NOT restarting, UI NOT published." >&2
        exit 1
    elif [ "$rc" != 0 ]; then
        echo "!! handoff unavailable (the old process is still serving); falling back to a restart" >&2
        restart=true
    fi
fi
if $restart; then
    say "restarting $SERVICE"
    systemctl --user restart "$SERVICE"
fi

# Generous, because a restart PRELOADS persistent models before it serves — a
# 30s window reported a healthy daemon as dead while it was loading 30 GB of
# weights, and then correctly-but-needlessly refused to publish the UI.
say "waiting for health (a restart preloads persistent models first)"
for _ in $(seq 1 180); do
    if curl -fsS -m 2 "$BASE/health" >/dev/null 2>&1; then
        version=$(curl -fsS -m 2 "$BASE/health" | python3 -c 'import json,sys; print(json.load(sys.stdin).get("version","?"))')
        echo "    up: $version"
        break
    fi
    sleep 1
done
if ! curl -fsS -m 2 "$BASE/health" >/dev/null 2>&1; then
    echo "!! $SERVICE did not answer within 3 minutes; UI NOT published (old one still serving)" >&2
    echo "   journalctl --user -u $SERVICE -n 50" >&2
    exit 1
fi

if $SKIP_UI; then
    say "done (UI skipped)"
    exit 0
fi

# Only now: the server can answer whatever the new UI asks.
say "building the UI (this IS the deploy — ui/dist is the live web root)"
(cd ui && npx vite build >/dev/null)

# vite empties outDir, which removes a tracked file. Restoring it here rather
# than leaving a spurious deletion in every deploy's git status.
if git -C "$root" ls-files --error-unmatch ui/dist/.gitkeep >/dev/null 2>&1; then
    git -C "$root" checkout -- ui/dist/.gitkeep 2>/dev/null || true
fi

say "deployed"
curl -fsS -m 5 "$BASE/health" | python3 -m json.tool 2>/dev/null || true
