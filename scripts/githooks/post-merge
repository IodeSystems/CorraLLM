#!/bin/sh
# ui/src/gql is GITIGNORED — generated, never committed. A merge that moves
# ui/gen/schema.graphql therefore leaves the typed documents describing the OLD
# schema, and the failure does not look like a missing file: tsc reports dozens
# of "implicitly has an 'any' type" errors in files the merge never touched,
# which reads like the branch was broken.
#
# Cost, 2026-09-25: a branch whose own gates were green arrived with a red tsc
# and the diagnosis took longer than the fix.
#
# A hook rather than a line in CLAUDE.md, because it has to hold every time.
if git diff --name-only ORIG_HEAD HEAD 2>/dev/null | grep -q '^ui/gen/schema.graphql$'; then
  echo "post-merge: schema.graphql moved -> make gen"
  make gen || echo "post-merge: make gen FAILED — run it before tsc, or typecheck will lie about where the error is" >&2
fi
exit 0   # never fail the merge itself; the merge was fine
