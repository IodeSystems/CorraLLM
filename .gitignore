# Go build artifacts
/bin/corrallm
/tmp/

# Air
/tmp/

# UI
/ui/node_modules/
# ui/dist is handled by ui/.gitignore: its contents are ignored except a tracked
# .gitkeep, which keeps ui/embed.go's //go:embed pattern matching on a clean
# checkout (an embed that matches nothing is a compile error).
/ui/src/gql/
# ui/src/routeTree.gen.ts is committed (tsc -b needs it before vite regenerates it)

# Runtime state
/home/var/
*.db
*.db-shm
*.db-wal

# Secrets (layered .properties)
/home/secret.properties
/home/*.local.properties
/home/*.secret.properties

# Local config override
/corrallm.local.yaml

# Editor
.DS_Store

# Machine-specific local working dir (configs, models, scratch) — never committed
/local/

# local MCP tooling
.mcp.json
.poly-lsp-mcp/

# runtime-generated admin token (never commit)
home/*.token

# Cross-compiled agent binaries built by `make agents` and served at /install/.
# Build artifacts, not source: ~37 MB each, rebuilt per commit.
bin/agents/
go.work
go.work.sum
